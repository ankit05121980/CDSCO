{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --no-frozen-lockfile",
  "buildCommand": "pnpm --filter backend build && pnpm --filter frontend build && rm -rf dist && cp -r frontend/dist dist",
  "outputDirectory": "dist",
  "functions": {
    "api/[...path].js": {
      "memory": 1024,
      "maxDuration": 60,
      "includeFiles": "backend/dist/**"
    }
  },
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
